rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isFitTrackPartner(ownerUid) {
      return exists(/databases/$(database)/documents/fittrackPartners/$(ownerUid + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/fittrackPartners/$(ownerUid + '_' + request.auth.uid)).data.inviteStatus == 'accepted';
    }
    function isFitTrackOwnerManagingPartner() {
      return resource.data.fittrackLinkedOwnerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fittrackLinkedOwnerId']);
    }

    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isFitTrackOwnerManagingPartner();
      allow delete: if isOwner(uid);
    }
    // FitTrack, water and nutrition data live under users/{uid}/...
    match /users/{uid}/{document=**} {
      allow read: if isAuth();
      allow write: if isOwner(uid) || isFitTrackPartner(uid);
    }
    match /fittrackPartners/{memberId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }
    match /globalFoods/{foodId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
  }
}
