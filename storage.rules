rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isFitTrackPartner(ownerUid) {
      return firestore.exists(/databases/(default)/documents/fittrackPartners/$(ownerUid + '_' + request.auth.uid))
        && firestore.get(/databases/(default)/documents/fittrackPartners/$(ownerUid + '_' + request.auth.uid)).data.inviteStatus == 'accepted';
    }

    // Profile photo, exercise variation images and progress photos/videos.
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isOwner(userId) || isFitTrackPartner(userId);
    }
  }
}
